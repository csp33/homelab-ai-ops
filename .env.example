# ==============================================================================
# Homelab AIOps Configuration Example
# Copy this file to .env and fill in your credentials. DO NOT commit .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# homelab-mcp Server Settings
# ------------------------------------------------------------------------------
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_TRANSPORT=http

# Telegram Bot (for alert reporting and interactive HITL buttons)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=-1001234567890

# Home Assistant (Optional)
HASS_URL=http://homeassistant.default.svc.cluster.local:8123
HASS_TOKEN=your-long-lived-access-token

# UniFi Network Controller (Optional)
UNIFI_HOST=https://192.168.1.1
UNIFI_USER=admin
UNIFI_PASSWORD=your-unifi-password
UNIFI_SITE=default

# Grafana (Optional)
GRAFANA_URL=http://grafana.monitoring.svc.cluster.local:3000
GRAFANA_TOKEN=your-grafana-service-account-token
GRAFANA_COMMAND=npx -y @grafana/mcp-server@latest

# ------------------------------------------------------------------------------
# LYOKO Agent Settings
# ------------------------------------------------------------------------------
LYOKO_HOST=0.0.0.0
LYOKO_PORT=9000
MCP_SERVER_URL=http://localhost:8000/mcp

# Observability (Optional - Langfuse / OpenTelemetry)
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
