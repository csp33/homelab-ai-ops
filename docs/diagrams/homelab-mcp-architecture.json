      "dot": "cyan",
      "title": "Scoped Tool Search",
      "items": [
        "Multi-token relevance scoring with domain alias resolution",
        "Keyword weighting and full-match bonuses place exact tools at rank #1",
        "Biases read-only tools by default unless mutation intent is detected"
      ]
    },
