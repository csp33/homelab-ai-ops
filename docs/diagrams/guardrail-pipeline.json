  "cards": [
    {
      "dot": "rose",
      "title": "Fail-Closed Pipeline",
      "items": [
        "Evaluates security rules sequentially before calling any upstream",
        "The first failing check immediately rejects the request with an explicit error",
        "Prevents unauthenticated or dangerous payloads from executing"
      ]
    },
    {
      "dot": "emerald",
      "title": "Protected Namespaces",
      "items": [
        "Critical namespaces like kube-system are read-only by default",
        "Mutating operations (scale, delete, restart) are permanently blocked",
        "Target namespace extracted from args, manifests, and cluster context"
      ]
    },
    {
      "dot": "violet",
      "title": "Command Exec Inspection",
      "items": [
        "Analyzes container exec and shell payloads using POSIX shlex parsing",
        "Blocks destructive commands (rm -rf, dd, mkfs, fork bombs)",
        "GitHub operations restricted to authorized repository allowlists"
      ]
    }
  ]
